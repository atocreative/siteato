PORT=3000
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=256
NO_UPDATE_CHECK=1
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false
CI=true
# Variáveis do site (também aceita as legadas VITE_*): NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SITE_NAME, NEXT_PUBLIC_GA_MEASUREMENT_ID, NEXT_PUBLIC_INDEXNOW_KEY, NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION, NEXT_PUBLIC_BING_SITE_VERIFICATION, NEXT_PUBLIC_META_PIXEL_ID, NEXT_PUBLIC_CLARITY_ID, NEXT_PUBLIC_GTM_ID
